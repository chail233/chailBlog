---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/jetbrains-mono';
/* 霞鹜文楷等宽版：cn-font-split 按 unicode-range 分片，浏览器只下载页面用到的那几片 */
import '@callmebill/lxgw-wenkai-web/lxgwwenkaimono-regular/result.css';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_START_DATE, CATEGORIES } from '../const';
import ThemeToggle from '../components/ThemeToggle.astro';

/* 全站样式按职责拆分到 src/styles/*.css，导入顺序即层叠顺序（令牌→基础→背景→框架→卡片→正文→动效） */
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/background.css';
import '../styles/chrome.css';
import '../styles/cards.css';
import '../styles/prose.css';
import '../styles/animations.css';

const GITHUB_URL = 'https://github.com/chail233';
const EMAIL = '1744315424@qq.com';
const CODEFORCES_URL = 'https://codeforces.com/profile/chail233';
const LUOGU_URL = 'https://www.luogu.com.cn/user/1940369';
const WECHAT_URL =
  'https://mp.weixin.qq.com/mp/profile_ext?action=home&__biz=MzY0MDA2NjE3OA==&scene=124#wechat_redirect';

interface Props {
  title?: string;
  description?: string;
  /** 文章页传 article，其余默认 website */
  type?: 'website' | 'article';
  /** OG 分享图相对路径；缺省时回退到站点默认图 /og/site.png */
  image?: string;
}

const {
  title,
  description = SITE_DESCRIPTION,
  type = 'website',
  image,
} = Astro.props;
const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const path = Astro.url.pathname;
// canonical / og:url 用站点绝对 URL（依赖 astro.config 的 site）
const canonical = new URL(path, Astro.site).href;
const rssUrl = new URL('rss.xml', Astro.site).href;
// OG 分享图：文章页传入自身图，其余回退站点默认图（均需绝对 URL）
const ogImage = new URL(image ?? '/og/site.png', Astro.site).href;
// 已运行天数（含建站当天）：构建时值作为无 JS 兜底，客户端脚本会按访问时刻实时更新
const MS_PER_DAY = 86400000;
const startMs = new Date(`${SITE_START_DATE}T00:00:00`).getTime();
const siteDays = Math.max(1, Math.floor((Date.now() - startMs) / MS_PER_DAY) + 1);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <!-- 主题初始化：在首屏绘制前设定 data-theme，避免深浅色切换闪烁(FOUC) -->
    <!-- data-astro-rerun：同文档导航(视口过渡)后重新执行，确保 data-theme 不被 morph 丢失 -->
    <script is:inline data-astro-rerun>
      (() => {
        let t;
        try {
          const s = localStorage.getItem('theme');
          t =
            s ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light');
        } catch {
          t = 'light';
        }
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
    <!-- 滚动揭示开关：仅当未开启“减弱动效”时标记 html.js-reveal（首屏绘制前，无闪烁） -->
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-reveal');
      }
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <!-- 页面切换过渡（View Transitions）：同文档导航平滑淡入 -->
    <ClientRouter />

    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={rssUrl}
    />

    <!-- Open Graph / 社交分享卡片 -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- 禁用 JS 时，回退到跟随系统的深色模式 -->
    <noscript>
      <style is:global>
        @media (prefers-color-scheme: dark) {
          :root {
            --fg: #c9d1d9;
            --fg-muted: #7d8590;
            --bg: #0b0f14;
            --bg-soft: #131a22;
            --bg-card: rgba(16, 22, 29, 0.5);
            --border: #232b33;
            --accent: #3ddc84;
            --tag-bg: #0e2a1c;
            --tag-fg: #56d364;
            --header-bg: rgba(11, 15, 20, 0.82);
            --grid: rgba(61, 220, 132, 0.06);
            --glow: rgba(61, 220, 132, 0.36);
            --glow-2: rgba(88, 166, 255, 0.28);
            --noise: 0.05;
            color-scheme: dark;
          }
          .astro-code,
          .astro-code span {
            color: var(--shiki-dark) !important;
            background-color: var(--shiki-dark-bg) !important;
          }
        }
      </style>
    </noscript>
  </head>
  <body>
    <div class="aurora" aria-hidden="true">
      <span class="aurora__blob aurora__blob--a"></span>
      <span class="aurora__blob aurora__blob--b"></span>
      <span class="aurora__blob aurora__blob--c"></span>
    </div>
    <header class="site-header">
      <div class="container nav-row">
        <a href="/" class="site-title">{SITE_TITLE}</a>
        <div class="nav-actions">
          <nav>
            <a href="/" class:list={[{ active: path === '/' }]}>首页</a>
            {
              CATEGORIES.map((cat) => (
                <a
                  href={`/category/${cat.slug}`}
                  class:list={[{ active: path === `/category/${cat.slug}` }]}
                >
                  {cat.name}
                </a>
              ))
            }
            <a
              href="/about"
              class:list={[{ active: path === '/about' }]}>关于</a
            >
          </nav>
          <ThemeToggle />
        </div>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-row">
        <span class="footer-copy">
          © {new Date().getFullYear()} chail · <span class="muted">Powered by Astro</span> · <span class="muted">已运行 <span id="site-days">{siteDays}</span> 天 · 访问 <span id="busuanzi_value_site_pv">–</span> 次 · <span id="busuanzi_value_site_uv">–</span> 位访客</span>
        </span>
        <nav class="footer-links" aria-label="社交链接">
          <a href={GITHUB_URL} rel="me noopener" target="_blank" title="GitHub" aria-label="GitHub">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.3-1.7-1.3-1.7-1.06-.72.08-.71.08-.71 1.17.08 1.79 1.2 1.79 1.2 1.04 1.79 2.73 1.27 3.4.97.1-.76.4-1.27.73-1.56-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.19-3.08-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z"/></svg>
          </a>
          <a href={CODEFORCES_URL} rel="me noopener" target="_blank" title="Codeforces" aria-label="Codeforces">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          </a>
          <a href={LUOGU_URL} rel="me noopener" target="_blank" title="洛谷" aria-label="洛谷">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </a>
          <a href={WECHAT_URL} rel="noopener" target="_blank" title="微信公众号" aria-label="微信公众号">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          </a>
          <a href="/rss.xml" title="RSS" aria-label="RSS">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9h2.5A11.5 11.5 0 0 0 4 8.5V11z"/><path d="M4 4a16 16 0 0 1 16 16h2.5A18.5 18.5 0 0 0 4 1.5V4z"/><circle cx="6" cy="18" r="2"/></svg>
          </a>
          <a href={`mailto:${EMAIL}`} title="Email" aria-label="Email">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          </a>
        </nav>
      </div>
    </footer>

    <script>
      // 滚动揭示：进入视口的卡片/年份标题淡入上浮。
      // 兼容 View Transitions：每次 astro:page-load 重建 IntersectionObserver（节点会随导航替换）。
      let revealIO: IntersectionObserver | null = null;

      function setupReveal() {
        // 未标记 js-reveal（无 JS 或减弱动效）时，内容本就可见，无需处理
        if (!document.documentElement.classList.contains('js-reveal')) return;

        if (revealIO) {
          revealIO.disconnect();
          revealIO = null;
        }

        const targets = Array.from(
          document.querySelectorAll<HTMLElement>(
            '.post-list li:not(.reveal-in), .archive-year:not(.reveal-in)',
          ),
        );
        if (!targets.length) return;

        revealIO = new IntersectionObserver(
          (entries) => {
            // 同批进入视口的元素按位置排序，逐个加 70ms 延迟形成错峰
            const hit = entries
              .filter((e) => e.isIntersecting)
              .sort(
                (a, b) => a.boundingClientRect.top - b.boundingClientRect.top,
              );
            for (let i = 0; i < hit.length; i++) {
              const el = hit[i].target as HTMLElement;
              el.style.transitionDelay = `${i * 70}ms`;
              el.classList.add('reveal-in');
              revealIO?.unobserve(el);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.1 },
        );

        for (const el of targets) revealIO.observe(el);
      }

      setupReveal();
      document.addEventListener('astro:page-load', setupReveal);
    </script>

    <!-- 访问统计（不蒜子）：自动填充页脚/文章页的 PV、UV 占位元素 -->
    <script is:inline async data-busuanzi src="https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
    <script is:inline define:vars={{ siteStart: SITE_START_DATE }}>
      (() => {
        // 已运行天数：按访客本地时间计算，跨天无需重新构建
        const updateDays = () => {
          const el = document.getElementById('site-days');
          if (!el) return;
          const days = Math.max(
            1,
            Math.floor(
              (Date.now() - new Date(siteStart + 'T00:00:00').getTime()) /
                86400000,
            ) + 1,
          );
          el.textContent = String(days);
        };
        updateDays();
        document.addEventListener('astro:page-load', updateDays);

        // View Transitions 导航后新 body 里的脚本不会自动执行，需重新触发不蒜子取数并计数新页面 PV。
        // 注意：不能用 cloneNode（规范会将克隆体标记为 already started 而永不执行），
        // 必须 createElement 新建一个真正的 script 插入才会下载执行。
        document.addEventListener('astro:after-swap', () => {
          const s = document.querySelector('script[data-busuanzi]');
          if (!s) return;
          const fresh = document.createElement('script');
          fresh.async = true;
          fresh.src = s.src;
          fresh.dataset.busuanzi = '';
          s.replaceWith(fresh);
        });
      })();
    </script>
  </body>
</html>
