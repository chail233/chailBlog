---
---

<button
  id="theme-toggle"
  class="theme-toggle"
  type="button"
  aria-label="切换深色模式"
  title="切换主题"
>
  <!-- 浅色时显示月亮：点击切到深色 -->
  <svg
    class="icon icon-moon"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
  <!-- 深色时显示太阳：点击切回浅色 -->
  <svg
    class="icon icon-sun"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
    ></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
    line-height: 1;
    transition: color 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
  }

  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .theme-toggle:active {
    transform: scale(0.92);
  }

  .icon {
    width: 1.05rem;
    height: 1.05rem;
    transition: transform 0.4s ease;
  }

  .theme-toggle:hover .icon {
    transform: rotate(28deg) scale(1.12);
  }

  .icon-sun {
    display: none;
  }

  :root[data-theme='dark'] .icon-sun {
    display: block;
  }

  :root[data-theme='dark'] .icon-moon {
    display: none;
  }
</style>

<script>
  const KEY = 'theme';
  const root = document.documentElement;

  const apply = (t: string) => root.setAttribute('data-theme', t);

  // 当前应有主题：本地存储优先，否则跟随系统
  const resolve = (): string => {
    try {
      return (
        localStorage.getItem(KEY) ||
        (window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light')
      );
    } catch {
      return 'light';
    }
  };

  // 事件委托：View Transitions 会替换按钮节点，绑在 document 上不会失效
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (!target || !target.closest('#theme-toggle')) return;
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    apply(next);
    try {
      localStorage.setItem(KEY, next);
    } catch {
      /* 忽略隐私模式下的写入异常 */
    }
  });

  // 同文档导航后：在绘制前恢复主题，避免 morph 清掉 data-theme 导致深色消失
  document.addEventListener('astro:after-swap', () => apply(resolve()));

  // 用户未显式选择时，跟随系统深浅色变化
  const mq = window.matchMedia('(prefers-color-scheme: dark)');
  mq.addEventListener('change', (e) => {
    let stored: string | null = null;
    try {
      stored = localStorage.getItem(KEY);
    } catch {
      /* ignore */
    }
    if (!stored) apply(e.matches ? 'dark' : 'light');
  });
</script>
