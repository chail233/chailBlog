---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostItem from '../components/PostItem.astro';
import { CATEGORIES } from '../const';
import { sortPostsByDate, type Post } from '../utils/post';

const posts = sortPostsByDate(
  await getCollection('posts', ({ data }) => !data.draft),
);

// 按年份分组（新→旧）
const byYear = new Map<number, Post[]>();
for (const post of posts) {
  const y = post.data.date.getFullYear();
  const arr = byYear.get(y);
  if (arr) arr.push(post);
  else byYear.set(y, [post]);
}
const groups = [...byYear.entries()];

// 分类统计（用于 Hero）
const counts = new Map<string, number>();
for (const p of posts) {
  for (const c of p.data.categories) counts.set(c, (counts.get(c) ?? 0) + 1);
}
const statItems = CATEGORIES.map((c) => ({
  name: c.name,
  slug: c.slug,
  count: counts.get(c.name) ?? 0,
}));
---

<BaseLayout>
  <section class="hero" aria-label="站点简介">
    <p class="hero-eyebrow">CHAIL的云存档</p>
    <h1 class="hero-title">
      Love My Life & <span class="accent">Poetry</span>。
    </h1>
    <p class="hero-sub">
      这里收录着我的学习笔记与日常随笔--欢迎你的访问。
    </p>
    <ul class="hero-stats">
      <li class="hero-stat">
        <span class="stat-num">{posts.length}</span>
        <span class="stat-label">篇文章</span>
      </li>
      {
        statItems.map((s) => (
          <li class="hero-stat">
            <span class="stat-num">{s.count}</span>
            <span class="stat-label">{s.name}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <p class="search-wrap">
    <span class="search-prompt" aria-hidden="true">$</span>
    <input
      id="post-filter"
      class="post-filter"
      type="search"
      placeholder="grep 文章标题…"
      aria-label="按标题搜索文章"
      autocomplete="off"
    />
  </p>

  <div class="archive-tools">
    <button type="button" class="tool-btn" data-expand-all>
      展开全部
    </button>
    <button type="button" class="tool-btn" data-collapse-all>
      折叠全部
    </button>
  </div>

  <div class="archive">
    {
      groups.map(([year, list], i) => {
        // 默认仅展开最新年份，其余折叠，避免主页一次性全部铺开
        const expanded = i === 0;
        return (
          <section
            class="archive-group"
            data-year={year}
            data-expanded={expanded}
            data-default-expanded={expanded}
          >
            <h2 class="archive-year">
              <button
                type="button"
                class="year-toggle"
                aria-expanded={expanded}
                aria-controls={`year-list-${year}`}
              >
                <span class="caret" aria-hidden="true">
                  ▾
                </span>
                <span class="comment">#</span>
                <span class="year-label">{year}</span>
                <span class="year-count">{list.length} 篇</span>
              </button>
            </h2>
            <div class="archive-body" id={`year-list-${year}`}>
              <ul class="post-list">
                {list.map((post) => (
                  <li data-title={post.data.title.toLowerCase()}>
                    <PostItem post={post} />
                  </li>
                ))}
              </ul>
            </div>
          </section>
        );
      })
    }
    <p class="archive-empty" hidden>
      <span class="search-prompt" aria-hidden="true">$</span> 没有匹配的文章。
    </p>
  </div>

  <script>
    // 统一用 document 事件委托：View Transitions 后节点会被替换，
    // 但 document 常驻，监听不会失效。

    /** 切换分组展开/折叠，同步 aria-expanded */
    function setExpanded(group: HTMLElement, expanded: boolean) {
      group.dataset.expanded = String(expanded);
      group
        .querySelector<HTMLElement>('.year-toggle')
        ?.setAttribute('aria-expanded', String(expanded));
    }

    /** 按标题过滤：命中项显示，搜索时自动展开有结果的分组，清空时恢复默认折叠态 */
    function applyFilter(q: string) {
      const groups = Array.from(
        document.querySelectorAll<HTMLElement>('.archive-group'),
      );
      let visible = 0;
      for (const li of document.querySelectorAll<HTMLElement>(
        '.post-list li[data-title]',
      )) {
        const hit = !q || (li.dataset.title ?? '').includes(q);
        li.hidden = !hit;
        if (hit) visible += 1;
      }
      for (const g of groups) {
        const any = Array.from(
          g.querySelectorAll<HTMLElement>('li[data-title]'),
        ).some((li) => !li.hidden);
        g.hidden = !any;
        if (q) setExpanded(g, any);
        else setExpanded(g, g.dataset.defaultExpanded === 'true');
      }
      const empty = document.querySelector<HTMLElement>('.archive-empty');
      if (empty) empty.hidden = visible !== 0;
    }

    document.addEventListener('input', (e) => {
      const target = e.target as HTMLElement;
      if (!target || target.id !== 'post-filter') return;
      applyFilter((target as HTMLInputElement).value.trim().toLowerCase());
    });

    document.addEventListener('click', (e) => {
      const from = e.target as HTMLElement;

      const toggle = from.closest<HTMLElement>('.year-toggle');
      if (toggle) {
        const g = toggle.closest<HTMLElement>('.archive-group');
        if (g) setExpanded(g, g.dataset.expanded !== 'true');
        return;
      }

      if (from.closest<HTMLElement>('[data-expand-all]')) {
        for (const g of document.querySelectorAll<HTMLElement>(
          '.archive-group:not([hidden])',
        ))
          setExpanded(g, true);
        return;
      }

      if (from.closest<HTMLElement>('[data-collapse-all]')) {
        for (const g of document.querySelectorAll<HTMLElement>(
          '.archive-group:not([hidden])',
        ))
          setExpanded(g, false);
      }
    });
  </script>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: 1.5rem 0 2.25rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .hero-eyebrow {
    font-family: var(--font-ui);
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.9rem;
  }

  .hero-title {
    font-size: clamp(2.1rem, 7vw, 3.1rem);
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }

  .hero-title .accent {
    color: var(--accent);
  }

  .hero-sub {
    max-width: 34em;
    margin: 0 auto 1.6rem;
    color: var(--fg-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .hero-stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.7rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero-stat {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    padding: 0.5rem 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  .stat-num {
    font-family: var(--font-ui);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    font-size: 0.85rem;
    color: var(--fg-muted);
  }

  .search-wrap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1.5rem;
  }

  .search-prompt {
    font-family: var(--font-ui);
    color: var(--accent);
    font-weight: 700;
  }

  .post-filter {
    flex: 1;
    padding: 0.6rem 0.9rem;
    font-family: var(--font-ui);
    font-size: 0.92rem;
    color: var(--fg);
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .post-filter:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .archive-year {
    font-family: var(--font-ui);
    font-size: 1.05rem;
    color: var(--fg);
    margin: 2rem 0 0.8rem;
    font-variant-numeric: tabular-nums;
  }

  .archive-year .comment {
    color: var(--fg-muted);
  }

  .archive-group:first-of-type .archive-year {
    margin-top: 0;
  }

  /* 年份标题即折叠开关：整行可点，终端风三角指示 */
  .year-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0;
    margin: 0;
    font: inherit;
    color: inherit;
    text-align: left;
    background: none;
    border: 0;
    border-radius: 4px;
    cursor: pointer;
    transition: color 0.18s ease;
  }

  .year-toggle:hover {
    color: var(--accent);
  }

  .year-toggle:hover .year-count {
    color: var(--accent);
  }

  .caret {
    display: inline-block;
    color: var(--accent);
    font-size: 0.85em;
    transition: transform 0.2s ease;
  }

  .archive-group[data-expanded='false'] .caret {
    transform: rotate(-90deg);
  }

  .year-count {
    margin-left: auto;
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
  }

  /* 折叠体：grid-template-rows 1fr↔0fr 实现平滑高度动画 */
  .archive-body {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.3s ease;
  }

  .archive-group[data-expanded='false'] .archive-body {
    grid-template-rows: 0fr;
  }

  .archive-body > .post-list {
    overflow: hidden;
    min-height: 0;
  }

  .archive-tools {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin: -0.6rem 0 1.25rem;
  }

  .tool-btn {
    font-family: var(--font-ui);
    font-size: 0.8rem;
    color: var(--fg-muted);
    background: none;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.28rem 0.6rem;
    cursor: pointer;
    transition: color 0.18s ease, border-color 0.18s ease;
  }

  .tool-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .archive-empty {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-ui);
    color: var(--fg-muted);
    padding: 1rem 0;
  }
</style>
